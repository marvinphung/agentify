# Azure OpenAI/OpenAI-compatible endpoint. When AZURE_API_KEY=true, these values
# take precedence over LLM_API_KEY/LLM_BASE_URL/LLM_MODEL.
AZURE_API_KEY=false
AZURE_API_VERSION=2024-12-01-preview
AZURE_MODEL=gpt-4o-mini
AZURE_ENDPOINT=
AZURE_PUBLIC_API_KEY=
AZURE_PRIVATE_API_KEY_PATH=/app/.secrets/azure_private_api_key.enc
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BACKEND_URL=

# Zalo OA integration
ZALO_APP_ID=
