# Frontend calls the public Render backend through this URL.
# Set the same value in Vercel Environment Variables.
VITE_API_BASE_URL=https://api.agentify.io.vn

# Local dev proxy targets used by vite.config.ts.
VITE_PROXY_API_TARGET=https://api.agentify.io.vn
VITE_PROXY_V1_API_TARGET=https://api.agentify.io.vn
