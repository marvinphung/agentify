# Local: leave empty to call relative paths such as /api/... and let Vite proxy the backend.
# Production on Vercel: set this to the Render backend URL, for example:
# VITE_API_BASE_URL=https://api.agentify.io.vn
VITE_API_BASE_URL=

# Local dev proxy targets used by vite.config.ts.
VITE_PROXY_API_TARGET=http://127.0.0.1:8763
VITE_PROXY_V1_API_TARGET=http://131.153.239.187:8763
