{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.agentify.io.vn/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.agentify.io.vn/health"
    },
    {
      "source": "/v1/api/:path*",
      "destination": "https://api.agentify.io.vn/v1/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
